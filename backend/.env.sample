# Copy this file to .env and adjust values for your local setup.

# Connection string for the PostgreSQL database (SQLAlchemy + psycopg3 format).
DATABASE_URL=postgresql+psycopg://connectsphere:connectsphere@localhost:5432/connectsphere

# Comma-separated list is not supported here; edit app/config.py's default
# or set as a JSON array string if you need to override, e.g. '["http://localhost:5173"]'
CORS_ORIGINS=["http://localhost:5173"]
